# ==============================================================================
# Construction-Enterprise-OS — Environment Variables Example
# Copy to .env and fill in values before running docker compose up
# ==============================================================================

# --- Database ---
POSTGRES_USER=construction-os
POSTGRES_PASSWORD=construction-os_dev
POSTGRES_DB=construction-os
DATABASE_URL=postgresql://construction-os:construction-os_dev@postgres:5432/construction-os
TIMESCALE_URL=postgresql://construction-os:construction-os_dev@timescaledb:5432/construction-os_ts

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=construction-os
RABBITMQ_DEFAULT_PASS=construction-os_dev
RABBITMQ_URL=amqp://construction-os:construction-os_dev@rabbitmq:5672/

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch:9200

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Auth / JWT ---
# CHANGE IN PRODUCTION — generate with: openssl rand -hex 32
# ENVIRONMENT が development/test 以外では JWT_PUBLIC_KEY が必須
# (未設定のまま起動すると各サービスが明示的に中止します)
JWT_PUBLIC_KEY=generate-with-openssl-rand-hex-32
JWT_SECRET_KEY=dev-only-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Token Exchange / MCP audience (ADR-0003) ---
# auth: 既定は無効（Phase 0）。Phase 1 で true にする
TOKEN_EXCHANGE_ENABLED=false
# mcp: Phase 2 で 1（aud=api://ceos-mcp 以外のトークンを拒否）
MCP_REQUIRE_AUDIENCE=0
# mcp: 交換用クライアント資格情報（本番は Secrets で注入。値をコミットしない）
MCP_EXCHANGE_CLIENT_ID=
MCP_EXCHANGE_CLIENT_SECRET=

# --- API Gateway ---
GATEWAY_PORT=9000
# JSON map of route prefix → upstream service URL (Docker service names)
# UPSTREAM_SERVICES={"^/api/v1/auth": "http://auth:8000", ...}

# --- 暫定の資源上限宣言（上限であって割当ではない） ---
# Compose は `mem_limit`/`cpus` と `deploy.resources.limits` の両形式をサポートする。
# 本リポジトリは deploy 形式に統一する方針。前者が非対応という意味ではない。
# 値は暫定。stagingへ適用し限定health負荷を確認（reports/staging/）。業務容量は未受入。
# 静的検査: scripts/ci/check_memory_limits.py（環境変数の既定値のみを検査）。
# 承認済み適用後に HostConfig.Memory/NanoCpus と負荷時の挙動を別途確認する。
# サービス固有の暫定上限（elasticsearch 3G / kafka 2G 等）は compose 側で上書き。
CEOS_MEM_LIMIT=768M
CEOS_CPU_LIMIT=1.0

# --- Frontend ---
# Build-time: baked into Next.js bundle
NEXT_PUBLIC_API_GATEWAY=http://localhost:9000
# Runtime (Docker): overrides build-time value for server-side rewrites
API_GATEWAY=http://gateway:9000
NEXT_TELEMETRY_DISABLED=1

# --- Environment ---
ENVIRONMENT=docker

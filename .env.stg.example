# ==============================================================================
# Construction-Enterprise-OS — STAGING (stg) 環境変数テンプレート
#
# これは**変数名の一覧**であり、値はここに書かない。
# 実体は本ホストの ~/.config/ceos/stg.env（mode 0600）に置き、リポジトリへ入れない
# （`docs/architecture/ADR-0005-staging-environment.md` §5）。
#
# 生成:
#   scripts/stg/gen_stg_env.sh            # ~/.config/ceos/stg.env を新規生成
#   scripts/stg/gen_stg_env.sh --force    # 既存を置き換える（鍵がローテートする）
#
# 読み込み:
#   set -a; . ~/.config/ceos/stg.env; set +a
#
# 起動:
#   scripts/stg/up.sh
# ==============================================================================

# --- 環境識別 ----------------------------------------------------------------
# 各サービスは ENVIRONMENT が development / test 以外だと開発用既定鍵での起動を拒否する。
# docker-compose.stg.yml が staging を強制するため、ここでは設定しない。
# ENVIRONMENT=staging

# --- データベース（ホスト PostgreSQL 18 クラスタ 18/infra_stg / port 55438） ---
# 正本は Mirai-Platform-Infra の db/roles.yaml。CEOS 側でロールを発番しない。
# パスワードは bootstrap_stg_db.sh が払い出し、ここへ記録する。
STG_DATABASE_URL=postgresql+asyncpg://ceos_stg_app:__FILLED_BY_BOOTSTRAP__@10.201.0.1:55438/ceos_stg
# 管理用（マイグレーション適用時のみ。アプリのコンテナへは渡さない）
STG_DB_ADMIN_URL=postgresql://postgres@127.0.0.1:55438/ceos_stg
STG_DB_NAME=ceos_stg
STG_DB_APP_ROLE=ceos_stg_app
STG_DB_MIGRATOR_ROLE=ceos_stg_migrator
STG_DB_AUDIT_ROLE=ceos_stg_audit_reader
STG_DB_APP_PASSWORD=__FILLED_BY_BOOTSTRAP__
STG_DB_MIGRATOR_PASSWORD=__FILLED_BY_BOOTSTRAP__
STG_DB_AUDIT_PASSWORD=__FILLED_BY_BOOTSTRAP__

# --- JWT（stg 専用。開発用既定鍵は ENVIRONMENT=staging で拒否される） ----------
# 生成: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# 本番で RS256 化するまでの間は HS256 の共有鍵で運用する。
STG_JWT_ALGORITHM=HS256
STG_JWT_SECRET_KEY=__GENERATED__
STG_JWT_PRIVATE_KEY=__GENERATED__
STG_JWT_PUBLIC_KEY=__GENERATED__

# --- ミドルウェア（stg 専用の資格情報） ---------------------------------------
STG_RABBITMQ_DEFAULT_USER=ceos_stg
STG_RABBITMQ_DEFAULT_PASS=__GENERATED__
STG_MINIO_ROOT_USER=ceos_stg
STG_MINIO_ROOT_PASSWORD=__GENERATED__

# --- サービス間認証 -----------------------------------------------------------
STG_INTERNAL_API_KEY=__GENERATED__

# --- 公開入口（Cloudflare Tunnel / Access） -----------------------------------
STG_PUBLIC_BASE_URL=https://construction-os-stg.mirai-dx-platform.com
STG_ACCESS_TEAM_DOMAIN=__FILLED_BY_OPERATOR__
STG_ACCESS_AUD=__FILLED_BY_OPERATOR__

# --- スモークテスト -----------------------------------------------------------
# スモークテストが使う stg の管理ユーザー（合成データのみ。実データを入れない）
# 注意: @example.invalid / @example.com は RFC 2606 の予約ドメインで、pydantic の
# EmailStr が special-use として 422 にする（2026-10-14 実測）。プロジェクト自身の
# ドメイン上に存在しないローカル部を使う（実在の連絡先ではない）。
STG_SMOKE_ADMIN_EMAIL=stg-admin@stg.mirai-dx-platform.com
STG_SMOKE_ADMIN_PASSWORD=__GENERATED__
STG_SMOKE_BASE_URL=http://127.0.0.1:19500

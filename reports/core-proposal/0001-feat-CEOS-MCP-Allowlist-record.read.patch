diff --git a/tools/tests/test_tool_def_hash.py b/tools/tests/test_tool_def_hash.py
index 129895e..f464477 100644
--- a/tools/tests/test_tool_def_hash.py
+++ b/tools/tests/test_tool_def_hash.py
@@ -12,3 +12,13 @@ def test_mcip_document_search_hash_matches_allowlist():
     doc = json.loads((ROOT / "contracts/mcp-tools/mcip.json").read_text(encoding="utf-8"))
     tool = next(t for t in doc["tools"] if t["name"] == "mcip.document.search")
     assert tool_definition_sha256(tool) == "69765ede2331f8c6598b30f2489de96d53463be375581e007f83e6c7d4cf4b61"
+
+
+def test_ceos_contract_hashes_match_allowlist():
+    import yaml
+
+    doc = json.loads((ROOT / "contracts/mcp-tools/ceos.json").read_text(encoding="utf-8"))
+    allow = yaml.safe_load((ROOT / "registries/mcp-allowlist.yaml").read_text(encoding="utf-8"))
+    registered = {t["name"]: t["definition_sha256"] for s in allow["servers"] if s["server_id"] == "ceos" for t in s["tools"]}
+    computed = {t["name"]: tool_definition_sha256(t) for t in doc["tools"]}
+    assert registered and computed == registered
